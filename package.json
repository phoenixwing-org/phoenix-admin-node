{
  "name": "cool-admin",
  "version": "8.0.0",
  "packageManager": "pnpm@9.15.9",
  "description": "一个很酷的Ai快速开发框架",
  "private": true,
  "dependencies": {
    "@cool-midway/core": "^8.0.7",
    "@cool-midway/rpc": "^8.0.2",
    "@cool-midway/task": "^8.0.2",
    "@midwayjs/bootstrap": "^4.2.1",
    "@midwayjs/cache-manager": "^4.2.1",
    "@midwayjs/core": "^4.2.1",
    "@midwayjs/cron": "^4.2.1",
    "@midwayjs/cross-domain": "^4.2.1",
    "@midwayjs/info": "^4.2.1",
    "@midwayjs/koa": "^4.2.1",
    "@midwayjs/logger": "^4.1.0",
    "@midwayjs/static-file": "^4.2.1",
    "@midwayjs/typeorm": "^4.2.1",
    "@midwayjs/upload": "^4.2.1",
    "@midwayjs/validate": "^4.2.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.8.4",
    "cron": "^4.1.3",
    "download": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "mysql2": "^3.14.0",
    "pg": "^8.22.0",
    "svg-captcha": "^1.4.0",
    "tslib": "^2.8.1",
    "typeorm": "npm:@cool-midway/typeorm@0.3.20",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@midwayjs/bundle-helper": "^1.3.0",
    "@midwayjs/mock": "^4.2.1",
    "@types/jest": "^29.5.14",
    "@types/node": "22",
    "@yao-pkg/pkg": "^6.3.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.1",
    "rimraf": "^6.0.1",
    "sqlite3": "^5.1.7",
    "ts-jest": "^29.3.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@cool-midway/core>@midwayjs/cache-manager": "^4.2.1"
    },
    "patchedDependencies": {
      "@cool-midway/rpc@8.0.2": "patches/@cool-midway__rpc@8.0.2.patch",
      "@cool-midway/core@8.0.8": "patches/@cool-midway__core@8.0.8.patch"
    }
  },
  "scripts": {
    "start": "NODE_ENV=production node ./bootstrap.js",
    "dev": "rimraf src/index.ts && cool check && cross-env NODE_ENV=local mwtsc --cleanOutDir --watch --run ./scripts/dev-midway4.js --keepalive",
    "dev:midway4": "rimraf src/index.ts && cross-env NODE_ENV=midway4 mwtsc --cleanOutDir --watch --run ./scripts/dev-midway4.js --keepalive",
    "test": "cross-env NODE_ENV=unittest jest",
    "test:midway4": "cross-env NODE_ENV=unittest node ./scripts/verify-midway4-runtime.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:midway4": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:midway4",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "cool entity && bundle && mwtsc --cleanOutDir",
    "build:obfuscate": "cool entity && bundle && mwtsc --cleanOutDir && cool obfuscate",
    "pkg": "rimraf build && mkdir build && npm run build && pkg . -d > build/pkg.log",
    "pm2:start": "pm2 start ./bootstrap.js -i 1 --name cool-admin",
    "pm2:stop": "pm2 stop cool-admin & pm2 delete cool-admin"
  },
  "bin": "./bootstrap.js",
  "pkg": {
    "scripts": [
      "dist/**/*",
      "node_modules/axios/dist/node/*"
    ],
    "assets": [
      "public/**/*",
      "typings/**/*",
      "src/locales/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "build"
  },
  "repository": {
    "type": "git",
    "url": "https://cool-js.com"
  },
  "author": "COOL",
  "license": "MIT"
}
