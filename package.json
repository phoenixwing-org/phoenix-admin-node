{
  "name": "phoenix-admin-node",
  "version": "0.2.0",
  "packageManager": "pnpm@10.15.1",
  "description": "Phoenix Admin Host Node.js backend maintained from Cool Admin Midway 8.x",
  "private": true,
  "dependencies": {
    "@cool-midway/core": "^8.0.7",
    "@cool-midway/rpc": "^8.0.2",
    "@cool-midway/task": "^8.0.2",
    "@midwayjs/bootstrap": "^3.20.3",
    "@midwayjs/cache-manager": "^3.20.3",
    "@midwayjs/core": "^3.20.3",
    "@midwayjs/cron": "^3.20.3",
    "@midwayjs/cross-domain": "^3.20.3",
    "@midwayjs/info": "^3.20.3",
    "@midwayjs/koa": "^3.20.3",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/static-file": "^3.20.3",
    "@midwayjs/typeorm": "^3.20.3",
    "@midwayjs/upload": "^3.20.3",
    "@midwayjs/validate": "^3.20.3",
    "adm-zip": "^0.5.16",
    "axios": "^1.8.4",
    "cron": "^4.1.3",
    "download": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "mysql2": "^3.14.0",
    "pg": "^8.22.0",
    "svg-captcha": "^1.4.0",
    "tslib": "^2.8.1",
    "typeorm": "npm:@cool-midway/typeorm@0.3.20",
    "uuid": "^11.1.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@midwayjs/bundle-helper": "^1.3.0",
    "@midwayjs/mock": "^3.20.3",
    "@types/jest": "^29.5.14",
    "@types/node": "22",
    "@yao-pkg/pkg": "^6.3.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node ./bootstrap.js",
    "dev": "rimraf src/index.ts && cool check && cross-env NODE_ENV=local mwtsc --cleanOutDir --watch --run @midwayjs/mock/app.js --keepalive",
    "test": "cross-env NODE_ENV=unittest jest",
    "test:ci": "cross-env NODE_ENV=unittest jest --runInBand --passWithNoTests",
    "host:baseline": "node scripts/pah-host-baseline.cjs",
    "admin:clean-validation": "node scripts/phoenix-admin-clean-validation.mjs",
    "verify": "pnpm run lint && pnpm run test:ci && pnpm run build",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "cool entity && bundle && mwtsc --cleanOutDir && node scripts/copy-pah-plugin-artifacts.mjs",
    "build:obfuscate": "cool entity && bundle && mwtsc --cleanOutDir && node scripts/copy-pah-plugin-artifacts.mjs && cool obfuscate",
    "pkg": "rimraf build && mkdir build && npm run build && pkg . -d > build/pkg.log",
    "pm2:start": "pm2 start ./bootstrap.js -i 1 --name phoenix-admin-node",
    "pm2:stop": "pm2 stop phoenix-admin-node & pm2 delete phoenix-admin-node"
  },
  "bin": "./bootstrap.js",
  "pkg": {
    "scripts": [
      "dist/**/*",
      "node_modules/axios/dist/node/*"
    ],
    "assets": [
      "public/**/*",
      "typings/**/*",
      "src/locales/**/*",
      "dist/modules/*/pah-plugin.artifacts.json",
      "dist/modules/*/migrations/**/*.sql",
      "dist/modules/*/runtime/**/*.cjs",
      "dist/modules/pah/pah-host-schema.json",
      "dist/modules/pah/schema/**/*.sql",
      "dist/modules/pah/host-baseline/**/*.json",
      "dist/modules/pah/host-baseline/**/*.sql"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "build"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/phoenixwing/phoenix-admin-node.git"
  },
  "author": "COOL",
  "maintainers": [
    "PhoenixWing contributors"
  ],
  "license": "MIT"
}
